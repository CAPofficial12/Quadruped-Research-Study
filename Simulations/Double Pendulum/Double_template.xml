<mujoco model="Double">
    <compiler angle="radian" />
    <option timestep = "0.002"
            gravity = "0 0 -{G}"
            integrator = "RK4"/>
    <worldbody>

        <body name="link1" pos = "0 0 2">

            <joint name = "top_hinge"
                    type = "hinge"
                    axis = "1 0 0"
                    damping = "{C1}"/>
            
            <geom type = "capsule"
                fromto = "0 0 0 0 0 -{L1}"
                size = "0.08"
                rgba = "0 1 0 1"
                mass="1" />
        
            <body name="link2" pos = "0 0 -{L1}">

                <joint name = "bottom_hinge"
                        type = "hinge"
                        axis = "1 0 0"
                        damping = "{C2}"/>
                
                <geom type = "capsule"
                    fromto = "0 0 0 0 0 -{L2}"
                    size = "0.08"
                    rgba = "1 0 0 1"
                    mass="1" />
            
                <body name = "weight" pos = " 0 0 -{L2}">
                    <geom type="sphere" 
                    size="0.15" 
                    rgba = "0.8 0.8 0.8 1"
                    mass = "{M}"/>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>